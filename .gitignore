# ---------------------------------------------------------------------------
# Generated model files. Both notebooks re-create these from the shipped
# checkpoint in a few seconds, so there is no reason to track them.
# The checkpoint itself, pet-mad-xs-v1.6.0.ckpt (18 MB), is tracked: it ships
# without the LLPR uncertainty wrapper, so the notebooks export it directly and
# no second copy is ever written to disk.
# ---------------------------------------------------------------------------
*.pt

# ---------------------------------------------------------------------------
# Working backups (e.g. water-md.backup-20260819-110916/)
# ---------------------------------------------------------------------------
*.backup-*/

# ---------------------------------------------------------------------------
# Generated by the ethanol notebook -- NOT ethanol_ccsd_t.xyz (the shipped
# reference data) and NOT pics/ (figures used by the notebook)
# ---------------------------------------------------------------------------
ethanol-finetune/train.xyz
ethanol-finetune/val.xyz
ethanol-finetune/test.xyz
ethanol-finetune/options.yaml
ethanol-finetune/outputs/
ethanol-finetune/extensions/
ethanol-finetune/*.ckpt
ethanol-finetune/trajs/

# ---------------------------------------------------------------------------
# Generated by the live LAMMPS runs in the water notebook -- NOT water-md/trajs/,
# whose longer precomputed trajectories are shipped on purpose and are what the
# analysis cells actually read, and NOT water-md/data/ or water-md/pics/
# ---------------------------------------------------------------------------
water-md/water_thermo.out
water-md/water_traj.lammpstrj
water-md/nacl_thermo.out
water-md/nacl_traj.lammpstrj
water-md/ethanol_thermo.out
water-md/ethanol_traj.lammpstrj
water-md/log.lammps

# ---------------------------------------------------------------------------
# Superseded material
# ---------------------------------------------------------------------------
deprecated/

# ---------------------------------------------------------------------------
# jupyter / python
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
__pycache__/
*.pyc
